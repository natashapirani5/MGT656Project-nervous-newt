# Copy to .env for local use. NEVER commit .env. Placeholder values only.
DJANGO_DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Postgres, e.g. a Neon dev branch. If unset locally, SQLite is used.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Server-side only (AI itinerary, Sprint 2+)
OPENROUTER_API_KEY=sk-or-placeholder
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: override the fake grader passwords used by `manage.py seed`
SEED_ORGANIZER_PASSWORD=
SEED_PARTICIPANT_PASSWORD=
PORT=8000
